# ==============================================================================
#  exporter.py — FULL ENV (saare variables, ek jagah)
#  Dataset -> private Telegram channel · multi-account (strict alternate) · batched
#  ---------------------------------------------------------------------------
#  Isi file ko `.env` naam se save karo (ya Render/Railway ke Environment tab me
#  same keys daalo), phir:  python exporter.py
# ==============================================================================


# ------------------------------------------------------------------ 1. DATASET
# Hugging Face dataset (REQUIRED). Format: username/dataset-name
HF_DATASET=your-username/student-data

# Private / gated dataset ho tabhi bharo (public ho to khaali chhodo)
HF_TOKEN=

# Dataset ke andar ka config aur split
HF_CONFIG=default
HF_SPLIT=train


# --------------------------------------------------------------- 2. TELEGRAM
# Private channel (REQUIRED) — -100... wala id, ya @channelusername
# Bot(s) us channel me ADMIN hone chahiye (post permission)
CHANNEL_ID=-1001234567890123

# Aapki user id — progress / START / STOP messages yahan aayenge (@userinfobot)
# Bot ko pehle /start bhejna hoga
ADMIN_ID=123456789


# ------------------------------------------------- 3. ACCOUNTS (multi-account)
# Tarika A — lists (index se pairing: 11+h1+token1, 22+h2+token2, ...)
API_IDS=11,22,33,44,55
API_HASHES=hash1,hash2,hash3,hash4,hash5
BOT_TOKENS=111:AAA,222:BBB,333:CCC,444:DDD,555:EEE

# Tarika B — ek hi line me (A ki jagah): api_id:api_hash:bot_token
# ACCOUNTS=11:hash1:111:AAA, 22:hash2:222:BBB, 33:hash3:333:CCC

# Tarika C — single account (purane naam, sirf 1 account ho to)
# API_ID=11
# API_HASH=hash1
# BOT_TOKEN=111:AAA

# auto = api_id/hash mile to MTProto (koi 20msg/min limit nahi), warna bot API
# user = sirf MTProto | bot = sirf Bot API
MODE=auto


# --------------------------------------------------------------- 4. SPEED
# auto = message me jitne pretty records fit hote hain | count = fixed BATCH_SIZE
BATCH_MODE=auto

# max records per message (auto mode me upper cap)
BATCH_SIZE=20

# message size budget (Telegram hard limit 4096) — 3800 safe hai
MSG_CHARS=3800

# per account parallel messages -> total in-flight = accounts × ye
PER_ACCOUNT_CONCURRENCY=4

# per message gap (0 = full speed)
DELAY=0

# MTProto logins ke beech gap (ek saath login = FLOOD_WAIT)
LOGIN_STAGGER=0.8

# STRICT ALTERNATE: msg1->acc1, msg2->acc2, ... accN->acc1
#   1 = flood-wait me usi account ka wait (pattern + order intact)  [safe]
#   0 = agla free account use karo (thoda fast, pattern tootega)     [fast]
WAIT_FOR_ACCOUNT=1


# ------------------------------------------------------------- 5. ADMIN PROGRESS
# ADMIN_ID ko kitne second me progress (0 = band)
PROGRESS_EVERY=10

# state file kitne messages ke baad save ho
STATE_SAVE_EVERY=10


# ---------------------------------------------------------------- 6. RESUME
# jahan se shuru karna hai (0 = shuru se / state.json jahan tha wahan se)
START_OFFSET=0

# is offset par ruk jao (0 = end tak)
END_OFFSET=0

# resume state file (Render par disk mount: /var/data/state.json)
STATE_FILE=state.json


# ----------------------------------------------------------------- 7. LIMITS
# ek send fail hone par kitne retries (accounts × ye total attempts)
MAX_RETRIES=4

# isse bada record trim nahi hota -> poori .json file bhej di jaati hai (KB)
MAX_TRIM_KB=8


# ==============================================================================
#  OPTIONAL PURANE NAAM (agar upar wale set na ho to ye chalte hain)
#  TG_BOT_TOKEN / TG_BOT_CHAT / TG_CHANNEL / TG_API_ID / TG_API_HASH / TG_ADMIN_ID
#  BOT_CHAT_ID  → ADMIN_ID ka alias
#  CONCURRENCY  → PER_ACCOUNT_CONCURRENCY ka purana naam
# ==============================================================================
